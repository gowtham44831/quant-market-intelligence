# Market data
MARKET_API_KEY=replace_with_your_provider_key
LOOKBACK_DAYS=365

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password

# Model artifacts
MODEL_DIR=/opt/airflow/data/models

# Feature history
FEATURE_RETENTION_TRADING_DAYS=800
FEATURE_SOURCE_CALENDAR_DAYS=1460

# Forward model
TRAIN_LOOKBACK_DAYS=730
MIN_TRAIN_ROWS=2000
BUY_UP_PROB=0.55
SELL_DOWN_PROB=0.52
SIGNAL_TOPN=10

# Backtesting
FORWARD_BACKTEST_DAYS=240
FORWARD_BACKTEST_RETRAIN_DAYS=20
FORWARD_BACKTEST_COST_BPS=10

# Capital-constrained portfolio defaults
PORTFOLIO_BACKTEST_INITIAL_CAPITAL=5000
PORTFOLIO_BACKTEST_MAX_POSITIONS=10
PORTFOLIO_BACKTEST_MAX_POSITION_PCT=0.10
PORTFOLIO_BACKTEST_COST_BPS_PER_SIDE=10
PORTFOLIO_BACKTEST_SLIPPAGE_BPS_PER_SIDE=5
PORTFOLIO_BACKTEST_FRACTIONAL_SHARES=false
